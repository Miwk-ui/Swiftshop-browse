{
  "name": "swiftshop-browser",
  "version": "0.1.0",
  "description": "A minimal, measurement-driven desktop browser optimized for shopping on Target, Walmart, and Pokémon Center.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miwk-ui/Swiftshop-browse.git"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-main.mjs && node --test dist/tests/unit.test.js",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "bench": "npm run build && node dist/bench/run-bench.js",
    "bench:startup": "node dist/bench/run-bench.js --modes startup",
    "bench:nav": "node dist/bench/run-bench.js --modes nav",
    "bench:dns": "node dist/bench/run-bench.js --modes dns",
    "tune": "node dist/bench/run-bench.js --tune",
    "profile": "node dist/bench/run-bench.js --modes profile",
    "report": "node dist/bench/report-cli.js",
    "compare": "node dist/bench/compare-browsers.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.swiftshop.browser",
    "productName": "SwiftShop Browser",
    "win": {
      "target": ["nsis", "zip"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "config/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
